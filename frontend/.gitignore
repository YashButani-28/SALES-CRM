# Node dependency tree generated by package managers
node_modules/

# Bundled build output recreated by Vite/React
build/
dist/
coverage/

# Environment-specific configuration (keep example committed)
.env
.env.*
!.env.example

# Debug and runtime logs that should stay local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
errlog.txt

# Tooling caches and temporary folders
.cache/
.tmp/

# Editor/OS metadata unrelated to the app
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Locally generated artifacts and backups
*.local
*.bak
