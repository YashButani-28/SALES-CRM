{
  "name": "sales-crm-backend",
  "version": "1.0.0",
  "description": "Backend API for SALES CRM authentication and RBAC system",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "psql \"$DATABASE_URL\" -f src/db/migrations/001_init.sql && psql \"$DATABASE_URL\" -f src/db/migrations/002_role_module_permissions.sql",
    "seed": "node src/db/seed.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^6.16.3"
  }
}
