# Node dependency tree generated by package managers
node_modules/

# Per-environment secrets – keep .env.example committed for reference
.env
.env.*
!.env.example

# Runtime and package manager logs cluttering the repo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Compiled output and caches recreated by build/test tools
coverage/
dist/
build/
tmp/
temp/
.cache/

# Local database exports that can be regenerated
*.sql
*.sqlite

# Process identifiers and seed markers created at runtime
*.pid
*.seed

# OS/editor metadata not relevant to source control
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local scratch files / backups
*.local
*.bak
